{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "**/*.css"]
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useConst": "off",
        "useImportType": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useCollapsedElseIf": "off",
        "useConsistentArrayType": "error",
        "useEnumInitializers": "off",
        "useExponentiationOperator": "off",
        "useForOf": "off",
        "useFragmentSyntax": "off",
        "useNodejsImportProtocol": "off",
        "useNumberNamespace": "off",
        "useNumericSeparators": "off",
        "useSelfClosingElements": "off",
        "useShorthandAssign": "off",
        "useShorthandFunctionType": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noDoubleEquals": "off",
        "noConsole": "off",
        "noVar": "off",
        "noImplicitAnyLet": "error",
        "noAssignInExpressions": "error",
        "noConfusingVoidType": "error",
        "noEmptyBlockStatements": "error",
        "noMisleadingCharacterClass": "off",
        "useAwait": "error",
        "useIterableCallbackReturn": "off",
        "noArrayIndexKey": "off",
        "noUnsafeDeclarationMerging": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noStaticOnlyClass": "off",
        "noUselessThisAlias": "off",
        "noUselessTypeConstraint": "off",
        "useFlatMap": "off",
        "useOptionalChain": "error",
        "useSimplifiedLogicExpression": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noInvalidPositionAtImportRule": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/backend/services/auto-iteration/service/auto-iteration.service.ts",
        "src/client/features/chat/agent-activity/tool-renderers/tool-info-renderer.tsx",
        "src/client/features/chat/chat-input/hooks/use-chat-input-actions.ts",
        "src/client/features/chat/virtualized-message-list.tsx",
        "src/lib/diff/parse.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["prisma/generated/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
