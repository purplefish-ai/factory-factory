{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/backend/index.ts!",
        "src/backend/server.ts!",
        "src/backend/migrate.ts!",
        "src/backend/electron-utility-entry.ts!",
        "src/backend/mcp/workspace-mcp-server.ts!",
        "src/cli/index.ts!",
        "electron/main/index.ts!",
        "electron/preload/index.cts!",
        "src/client/main.tsx!",
        "src/client/features/workspace/diff-highlight.worker.ts!"
      ],
      "project": ["src/**/*.{ts,tsx,css,mdx}!", "electron/**/*.{ts,cts}!", "prisma/**/*.prisma!"]
    }
  },
  "paths": {
    "@/*": ["src/*"],
    "@prisma-gen/*": ["prisma/generated/*"]
  },
  "ignoreDependencies": ["@prisma/client"],
  "vitest": {
    "entry": ["src/**/*.test.{ts,tsx}", "vitest.config.ts"]
  },
  "storybook": {
    "entry": ["src/**/*.stories.tsx", ".storybook/**/*.{ts,tsx}"]
  },
  "ignoreExportsUsedInFile": true
}
