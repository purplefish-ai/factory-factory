{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/backend/index.ts!",
        "src/backend/server.ts!",
        "src/backend/migrate.ts!",
        "src/backend/mcp/workspace-mcp-server.ts!",
        "src/cli/index.ts!",
        "src/client/main.tsx!",
        "src/client/features/workspace/diff-highlight.worker.ts!",
        "src/client/lib/image-resize.worker.ts!"
      ],
      "project": ["src/**/*.{ts,tsx,css,mdx}!", "prisma/**/*.prisma!", "lint-rules/**/*.{mjs,ts}"]
    }
  },
  "paths": {
    "@/*": ["src/*"],
    "@prisma-gen/*": ["prisma/generated/*"]
  },
  "ignoreDependencies": ["@prisma/client"],
  "vitest": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "lint-rules/**/*.test.ts",
      "vitest.config.ts",
      "vitest.storybook.config.ts"
    ]
  },
  "storybook": {
    "entry": ["src/**/*.stories.tsx", ".storybook/**/*.{ts,tsx}"]
  },
  "ignoreExportsUsedInFile": true
}
