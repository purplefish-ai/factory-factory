{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/backend/server.ts",
        "src/backend/migrate.ts",
        "electron/main/index.ts",
        "electron/preload/index.cts"
      ],
      "project": ["src/**/*.{ts,tsx,css,mdx}", "electron/**/*.{ts,cts}", "prisma/**/*.prisma"]
    }
  },
  "paths": {
    "@/*": ["src/*"],
    "@prisma-gen/*": ["prisma/generated/*"]
  },
  "ignoreDependencies": ["@prisma/client"],
  "vitest": {
    "entry": ["src/**/*.test.{ts,tsx}", "vitest.config.ts"]
  },
  "storybook": {
    "entry": ["src/**/*.stories.tsx", ".storybook/**/*.{ts,tsx}"]
  }
}
