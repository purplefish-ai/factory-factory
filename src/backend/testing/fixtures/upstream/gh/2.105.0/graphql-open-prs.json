{
  "description": "Open pull requests, for local branch matching.",
  "args": [
    "api",
    "graphql",
    "-f",
    "query=\n        query {\n          repository(owner: \"example-owner\", name: \"example-repo\") {\n            pullRequests(\n              states: OPEN\n              first: 100\n              orderBy: { field: CREATED_AT, direction: DESC }\n            ) {\n              pageInfo { hasNextPage endCursor }\n              nodes { number url createdAt headRefName }\n            }\n          }\n        }\n      "
  ],
  "exitCode": 0,
  "stdoutFormat": "json",
  "stdout": {
    "data": {
      "repository": {
        "pullRequests": {
          "pageInfo": {
            "hasNextPage": false,
            "endCursor": "fake-cursor-5"
          },
