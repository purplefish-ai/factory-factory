// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// Enums

enum WorkspaceStatus {
  NEW          // Workspace created, nothing started
  PROVISIONING // Git worktree being created, startup script running
  READY        // Successfully initialized
  FAILED       // Initialization failed
  ARCHIVING    // Archive in progress (cleanup + transition)
  ARCHIVED     // Workspace archived
}

enum SessionStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum SessionLifecycleEventKind {
  TURN_INTERRUPTED
  SESSION_STOPPED
}

enum SessionLifecycleEventReason {
  PROMPT_TIMEOUT
  PROVIDER_ERROR
  USER_STOP
  SESSION_CLOSED
  WORKSPACE_ARCHIVED
  UNEXPECTED_EXIT
  SYSTEM_STOP
  VOICE_INTERRUPT
}

enum SessionProvider {
  CLAUDE
  CODEX
}

enum SessionPermissionPreset {
  STRICT
  RELAXED
  YOLO
}

enum RatchetReviewTriggerMode {
  CHANGES_REQUESTED
  ALL_REVIEW_FEEDBACK
}

enum WorkspaceProviderSelection {
  WORKSPACE_DEFAULT
  CLAUDE
  CODEX
}

enum PRState {
  NONE
  DRAFT
  OPEN
  CHANGES_REQUESTED
  APPROVED
  MERGED
  CLOSED
}

enum CIStatus {
  UNKNOWN   // No CI configured or not yet fetched
  PENDING   // CI is running
  SUCCESS   // All checks passed
  FAILURE   // One or more checks failed
}

/// Derived, never stored: computed from `WorkspacePR` by `deriveRatchetState`.
/// It stays declared here so `src/shared/core/enums.ts` keeps a schema-side pair
/// to be drift-checked against, and because it is still the vocabulary the
/// snapshot stream and the v4 export format speak.
enum RatchetState {
  IDLE              // No PR, PR closed, or ratchet disabled for this workspace
  CI_RUNNING        // CI checks in progress
  CI_FAILED         // CI checks failed
  MERGE_CONFLICT    // PR has merge conflicts with the base branch
  REVIEW_PENDING    // Has unaddressed review comments
  READY             // Ready to merge (CI green, no conflicts, no pending reviews)
  MERGED            // PR has been merged
}

enum RatchetDispatchOutcome {
  RUNNING     // Fixer session dispatched and believed to be working
  COMPLETED   // Fixer ended deliberately (finished its work or was stopped)
  DIED        // Fixer ended unexpectedly (crash / non-zero exit); eligible for bounded retry
}

enum WorkspaceCreationSource {
  MANUAL          // Created manually by user
  RESUME_BRANCH   // Created from existing branch
  GITHUB_ISSUE    // Created from GitHub issue
  LINEAR_ISSUE    // Created from Linear issue
  PERIODIC_TASK   // Created by a periodic task execution
  CHILD_WORKSPACE // Created as a child of another workspace
}

enum IssueProvider {
  GITHUB
  LINEAR
}

enum RunScriptStatus {
  IDLE       // No run script or not started
  STARTING   // Run script is starting
  RUNNING    // Run script is actively running
  STOPPING   // Run script is stopping
  COMPLETED  // Run script completed successfully
  FAILED     // Run script failed
}

enum WorkspaceMode {
  STANDARD
  AUTO_ITERATION
}

enum PeriodicTaskCadence {
  EVERY_MINUTE
  EVERY_FIVE_MINUTES
  DAILY
  WEEKLY
  MONTHLY
}

enum PeriodicTaskExecutionStatus {
  RUNNING       // Workspace created, agent working
  PR_CREATED    // Agent created a PR
  FAILED        // Workspace failed or errored
  SKIPPED       // Skipped (previous run still active)
}

enum AutoIterationStatus {
  IDLE            // Configured but not started
  RUNNING         // Loop is actively iterating
  PAUSED          // User paused the loop
  COMPLETED       // Target reached
  MAX_ITERATIONS  // Hit iteration limit
  STOPPED         // User manually stopped
  FAILED          // Unrecoverable error
}

enum NotificationDirection {
  CHILD_TO_PARENT
  PARENT_TO_CHILD
}


// Models
model Project {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  repoPath          String
  worktreeBasePath  String
  defaultBranch     String      @default("main")
  githubOwner       String?
  githubRepo        String?
  isArchived        Boolean     @default(false)

  // Issue provider configuration
  issueProvider         IssueProvider @default(GITHUB)
  issueTrackerConfig    Json?         // Typed blob — see IssueTrackerConfigSchema

  // Startup script configuration
  startupScriptCommand  String?   // Inline shell command
  startupScriptPath     String?             // Path to script in repo
  startupScriptTimeout  Int       @default(300)  // Timeout in seconds

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  workspaces        Workspace[]
  periodicTasks     PeriodicTask[]

  @@index([slug])
  @@index([isArchived])
  @@index([isArchived, updatedAt])
}

model DecisionLog {
  id                String      @id @default(cuid())
  agentId           String      // Can be sessionId or any identifier
  decision          String
  reasoning         String
  context           String?
  timestamp         DateTime    @default(now())

  @@index([agentId, timestamp])
  @@index([timestamp])
}

model Workspace {
  id                  String            @id @default(cuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id])
  name                String
  description         String?
  status              WorkspaceStatus   @default(NEW)
  worktreePath        String?
  branchName          String?
  isAutoGeneratedBranch Boolean         @default(false)  // True if branch was auto-generated at creation time

  // Workspace creation tracking
  creationSource      WorkspaceCreationSource  @default(MANUAL)  // How this workspace was created
  creationMetadata    Json?                                      // Additional creation context (nullable for flexibility)

  // Initialization tracking (used by NEW, PROVISIONING, FAILED states)
  initErrorMessage    String?
  initOutput          String?           // Accumulated stdout/stderr from startup script
  initStartedAt       DateTime?
  initCompletedAt     DateTime?
  initScriptPid       Int?              // Process ID of running startup/setup script
  initRetryCount      Int                 @default(0)

  githubIssueNumber   Int?
  githubIssueUrl      String?
  linearIssueId         String?   // Linear issue UUID
  linearIssueIdentifier String?   // Human-readable e.g. "ENG-123"
  linearIssueUrl        String?   // URL to Linear issue
  defaultSessionProvider WorkspaceProviderSelection @default(WORKSPACE_DEFAULT)
  agentSessions       AgentSession[]
  sessionLifecycleEvents SessionLifecycleEvent[]
  terminalSessions    TerminalSession[]
  closedSessions      ClosedSession[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // PR tracking (cached from GitHub) — see WorkspacePR
  prs                 WorkspacePR[]
  prDiscovery         WorkspacePRDiscovery?

  // Ratchet tracking (centralized PR progression) — see WorkspaceRatchet

  // Run script: the cached factory-factory.json commands and the process running
  // one of them — see WorkspaceRunScript
  runScript           WorkspaceRunScript?

  // Auto-iteration: the mode discriminant and the loop's state — see
  // WorkspaceAutoIteration
  autoIteration       WorkspaceAutoIteration?

  // Periodic task link
  periodicTaskId        String?
  periodicTask          PeriodicTask?           @relation(fields: [periodicTaskId], references: [id])
  periodicTaskExecution PeriodicTaskExecution?

  // Parent/child workspace hierarchy (max depth 1)
  parentWorkspaceId   String?           @map("parent_workspace_id")
  parentWorkspace     Workspace?        @relation("WorkspaceChildren", fields: [parentWorkspaceId], references: [id])
  childWorkspaces     Workspace[]       @relation("WorkspaceChildren")
  notifications       WorkspaceNotification[]
  prMonitoring        WorkspacePRMonitoring?
  prEvents            WorkspacePREvent[]

  // Activity tracking
  hasHadSessions      Boolean           @default(false)

  @@index([projectId])
  @@index([status])
  @@index([periodicTaskId])
  @@index([parentWorkspaceId])
  // Composite indexes for common query patterns
  @@index([projectId, status])
  @@index([projectId, updatedAt])
  @@index([projectId, createdAt])
  // The three composite indexes that used to lead with `status` and continue
  // into `prUrl` / `prUpdatedAt` / `prDiscoveryNextCheckAt` are gone with those
  // columns. Their queries now filter `status` here and the PR columns on
  // WorkspacePR, which carries the matching indexes.
}

/// Each association retains its own GitHub cache. Detached rows suppress discovery.
model WorkspacePR {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url String
  number Int?
  title String?
  headRefName String?
  baseRefName String?
  state PRState @default(NONE)
  reviewState String?
  ciStatus CIStatus @default(UNKNOWN)
  hasMergeConflict Boolean @default(false)
  syncedAt DateTime?
  detachedAt DateTime?
  revision Int @default(0)
  ciFailedAt DateTime?
  ciLastNotifiedAt DateTime?
  reviewLastCheckedAt DateTime?
  reviewLastCommentId String?
  observation Json?
  transitionSequence Int @default(0)
  observationEpoch Int @default(0)
  events WorkspacePREvent[]
  @@unique([workspaceId, url])
  @@index([workspaceId, detachedAt])
  @@index([syncedAt])
}

/// Discovery belongs to the workspace even before its first PR exists.
model WorkspacePRMonitoring {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  recipientSessionId String?
  recipient AgentSession? @relation("PRMonitoringRecipient", fields: [recipientSessionId], references: [id], onDelete: SetNull)
  bindingRevision Int @default(0)
  eventEpoch Int @default(0)
  deliveryPauseReason String?
  legacySessionIds Json @default("[]")
  lastCheckedAt DateTime?
  @@index([recipientSessionId])
}

model WorkspacePREvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prId String?
  pr WorkspacePR? @relation(fields: [prId], references: [id], onDelete: Cascade)
  kind String
  deduplicationKey String
  payload Json
  state String @default("PENDING")
  attempts Int @default(0)
  deliveryId String?
  deliverySessionId String?
  deliveryProvider String?
  deliveryProviderSessionId String?
  deliveryBindingRevision Int?
  deliveryText String?
  claimedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@unique([prId, deduplicationKey])
  @@unique([workspaceId, deduplicationKey])
  @@index([workspaceId, state, createdAt])
  @@index([deliveryId])
}

model WorkspacePRDiscovery {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastCheckedAt DateTime?
  retryCount Int @default(0)
  nextCheckAt DateTime?
  @@index([nextCheckAt])
}


/// The workspace's dev server: the commands `factory-factory.json` declares for
/// it, and the process currently running one of them.
///
/// Two groups in one row, on purpose. `command` / `postRunCommand` /
/// `cleanupCommand` are a cache of the config file in the worktree; `pid` /
/// `port` / `startedAt` / `status` describe a live process. They share a row
/// because they share a writer — `workspaceRunScriptService` is the only thing
/// that writes either — so splitting them would produce two accessors guarding
/// the same boundary, and because every read that wants one wants the workspace
/// anyway. Nothing here is written together across the groups, so no write
/// spans them.
///
/// The config group stays a cache rather than becoming a projection the way
/// `cachedKanbanColumn` and `RatchetState` did, and the reason is where the
/// source of truth lives. Those two were derived from other columns, so
/// computing them at read time cost nothing; these come from a file in the
/// worktree, and deriving them on read would mean a filesystem call per
/// workspace per list query. Drift is repaired at the point of use instead:
/// `reconcileWorkspaceCommandCache` re-reads the file before starting or
/// stopping a script and writes back what it finds.
///
/// The runtime group is persisted even though a restart invalidates the process,
/// because `pid` is the only handle on an orphan. Run scripts spawn with
/// `detached: false`, so they normally die with the server -- but a SIGKILL or a
/// crash leaves them running, and `verifyRunning` finds them again with
/// `process.kill(pid, 0)` against this column. `resetStaleTransientStatuses`
/// clears `STARTING` / `STOPPING` at startup for the same reason: those two
/// cannot survive the process that was mid-transition.
///
/// Exactly one row per workspace, created with the workspace, so the
/// compare-and-swap on `status` always has a row to guard. Reads substitute
/// defaults if a row is ever missing rather than making every caller handle the
/// null.
///
/// One consequence of the split, the same one the PR cache had: these writes no
/// longer touch `Workspace.updatedAt`, because Prisma's `@updatedAt` only fires
/// for the table being written. So starting or stopping a run script no longer
/// floats its workspace up the sidebar and board, which order by `updatedAt`.
/// That is deliberate -- a process exiting was never workspace activity, and the
/// activity the UI actually displays (`lastActivityAt`) is computed from session
/// timestamps, not this column. It also stops a busy run script from holding
/// `updatedAt` fresh enough to defer the stale-ARCHIVING recovery sweep.
model WorkspaceRunScript {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Cached from factory-factory.json in the worktree.
  command        String?                    // The run script command to execute
  postRunCommand String?                    // Runs after the run script reaches RUNNING
  cleanupCommand String?                    // Runs on stop

  // The process, if one is running.
  pid       Int?                            // Process ID of running script
  port      Int?                            // Allocated port for the running script
  startedAt DateTime?                       // When the run script was started
  status    RunScriptStatus @default(IDLE)   // Run script runtime status

  // Startup recovery scans `status IN ('STARTING','STOPPING')`, which at this
  // table's size is a scan either way; the pre-split column had no index and
  // this one does not need one. Nothing else filters or orders on these columns.
}

/// The auto-iteration loop's state, split off `Workspace` (issue: the model
/// carried six unrelated concerns). After creation it is written only by
/// `workspace-auto-iteration.accessor.ts`; the row itself is created with its
/// workspace by `workspaceAccessor.create`, which sets `mode` and `config` from
/// the creation input and is the one other writer the ownership rule permits.
/// Reads are flattened back onto the workspace under the old
/// `mode`/`autoIteration*` names, so the v4 export format and the client are
/// unchanged.
///
/// `mode` travels with the group rather than staying on `Workspace`. It reads
/// like a general workspace attribute, but every consumer is an auto-iteration
/// consumer: the kanban card gates its badge on it, the right panel and the
/// progress banner derive `isAutoIteration` from it, creation only validates it
/// against `autoIterationConfig`, and `auto-iteration.trpc.ts` uses it as an
/// entry guard. It is this group's discriminant, so it is this group's column --
/// the same call made for `ratchetEnabled` in the ratchet split.
///
/// Unlike the run script's, none of these fields are on the snapshot wire: the
/// client's snapshot adapter lists all five under `mutationOnlyFieldDefaults`,
/// because they change through explicit mutations rather than live activity.
/// The v4 export carries only `mode` and `autoIterationConfig`, both already
/// optional with defaults.
///
/// Same `updatedAt` consequence as the three splits before it: these writes no
/// longer touch `Workspace.updatedAt`, so loop progress does not float its
/// workspace up the sidebar and board. Deliberate, and consistent -- the
/// activity the UI displays is computed from session timestamps.
model WorkspaceAutoIteration {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  mode      WorkspaceMode        @default(STANDARD)
  status    AutoIterationStatus?
  config    Json?                // { testCommand, targetDescription, maxIterations, testTimeoutSeconds, sessionRecycleInterval }
  progress  Json?                // { currentIteration, baselineMetricSummary, currentMetricSummary, counts, timestamps }
  sessionId String?              // Active ACP session for the loop

  // Startup recovery scans `status = 'RUNNING'`; the pre-split column had no
  // index and this one does not need one at this table's size.
}

model AgentSession {
  prMonitoringBindings WorkspacePRMonitoring[] @relation("PRMonitoringRecipient")
  id                  String        @id @default(cuid())
  workspaceId         String
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String?
  workspacePrId       String? // Retained association for archived automated sessions
  workflow            String // "explore", "implement", "test"
  model               String        @default("sonnet")
  status              SessionStatus @default(IDLE)
  provider            SessionProvider
  providerSessionId   String?
  providerProjectPath String?
  providerProcessPid  Int?
  providerMetadata    Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([provider])
  @@index([workspaceId, provider])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
}

model SessionLifecycleEvent {
  id          String                      @id @default(cuid())
  workspaceId String
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId   String
  kind        SessionLifecycleEventKind
  reason      SessionLifecycleEventReason
  message     String
  dedupeKey   String
  createdAt   DateTime                    @default(now())

  @@unique([sessionId, dedupeKey])
  @@index([sessionId, createdAt])
  @@index([workspaceId])
}

model TerminalSession {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String?
  status          SessionStatus @default(IDLE)
  pid             Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, updatedAt])
}

model ClosedSession {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sessionId       String          // Original AgentSession ID
  name            String?
  workflow        String          // "ratchet", "ci-fix", etc.
  provider        SessionProvider
  model           String

  transcriptPath  String          // Relative path to transcript JSON file

  startedAt       DateTime
  completedAt     DateTime        @default(now())

  @@index([workspaceId])
  @@index([completedAt])
  @@index([sessionId, completedAt])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @default("default") @unique  // Single user for now, expandable later

  // IDE Settings
  preferredIde          String   @default("cursor")  // "cursor" | "vscode" | "custom"
  customIdeCommand      String?  // For custom IDE, supports placeholders like {workspace}

  // Notification Settings
  playSoundOnComplete   Boolean  @default(true)   // Play sound when workspace completes
  notificationSoundPath String?                   // Path to custom notification sound file

  // Sidebar Settings
  workspaceOrder      Json?    // { [projectId]: string[] } - ordered workspace IDs per project

  // Cached slash commands (from Claude CLI initialize response)
  cachedSlashCommands   Json?

  // Ratchet Settings (unified PR progression)
  ratchetEnabled            Boolean  @default(false)  // Default for new GitHub-issue-created workspaces
  ratchetReplyToPrComments  Boolean  @default(true)   // Whether Ratchet should post PR/review comment replies
  ratchetReviewTriggerMode  RatchetReviewTriggerMode @default(CHANGES_REQUESTED)
  defaultSessionProvider    SessionProvider @default(CLAUDE)
  defaultClaudeModel        String @default("sonnet")
  defaultCodexModel         String @default("default")
  defaultClaudeReasoningEffort String?
  defaultCodexReasoningEffort  String?
  defaultWorkspacePermissions SessionPermissionPreset @default(STRICT) // Default execution-mode preset for non-ratchet sessions
  autoIterationPermissions  SessionPermissionPreset @default(YOLO) // Execution preset for auto-iteration sessions

  // Adversarial Review Settings (on-demand review of the open PR by a different provider/model)
  reviewerSessionProvider   SessionProvider @default(CODEX) // Provider used for adversarial review sessions
  reviewerClaudeModel       String? // Reviewer model when reviewerSessionProvider is CLAUDE
  reviewerCodexModel        String? // Reviewer model when reviewerSessionProvider is CODEX
  postReviewToGitHub        Boolean @default(true) // Post the review to the PR; off runs in-app only

  // Voice Mode Settings (BYOK Deepgram)
  voiceModeEnabled          Boolean  @default(false)  // Admin toggle for the voice mode feature
  deepgramApiKeyEncrypted   String?                    // AES-256-GCM encrypted, same scheme as Linear's apiKey
  voiceTtsModel             String   @default("flux-haley-en")  // Deepgram Flux TTS voice, e.g. flux-haley-en
  voiceTtsSpeed             Float    @default(1)  // Deepgram TTS speed multiplier (0.5-2.0)
  voiceUtteranceEndMs       Int      @default(1000)  // Deepgram silence gap (ms) before a turn is considered done; lower = more aggressive
  voiceBargeInSustainedMs   Int      @default(16)  // Sustained loud-frame duration (ms) before barge-in triggers; lower = more aggressive

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model PeriodicTask {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id])

  name          String
  prompt        String
  cadence       PeriodicTaskCadence
  scheduledTime String?
  timezone      String?
  scheduledDayOfMonth Int?

  isEnabled   Boolean              @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  executions  PeriodicTaskExecution[]
  workspaces  Workspace[]

  @@index([projectId])
  @@index([isEnabled, nextRunAt])
}

model PeriodicTaskExecution {
  id              String                       @id @default(cuid())
  periodicTaskId  String
  periodicTask    PeriodicTask                 @relation(fields: [periodicTaskId], references: [id], onDelete: Cascade)

  workspaceId     String?                      @unique
  workspace       Workspace?                   @relation(fields: [workspaceId], references: [id])

  status          PeriodicTaskExecutionStatus
  prUrl           String?
  prNumber        Int?
  errorMessage    String?

  startedAt       DateTime                     @default(now())
  completedAt     DateTime?

  @@index([periodicTaskId])
  @@index([periodicTaskId, status])
  @@index([status])
}

// Queued notifications from child workspaces, delivered when parent's next session starts
model WorkspaceNotification {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceWorkspaceId   String    @map("source_workspace_id")
  sourceWorkspaceName String    @map("source_workspace_name")
  sourceProjectName   String    @map("source_project_name")
  message             String
  direction           NotificationDirection @default(CHILD_TO_PARENT)

  deliveredAt         DateTime? @map("delivered_at") // null = pending delivery

  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("workspace_notifications")
  @@index([workspaceId])
  @@index([workspaceId, deliveredAt])
}
