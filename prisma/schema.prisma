// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// Enums

enum WorkspaceStatus {
  NEW          // Workspace created, nothing started
  PROVISIONING // Git worktree being created, startup script running
  READY        // Successfully initialized
  FAILED       // Initialization failed
  ARCHIVING    // Archive in progress (cleanup + transition)
  ARCHIVED     // Workspace archived
}

enum SessionStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum SessionProvider {
  CLAUDE
  CODEX
}

enum SessionPermissionPreset {
  STRICT
  RELAXED
  YOLO
}

enum RatchetReviewTriggerMode {
  CHANGES_REQUESTED
  ALL_REVIEW_FEEDBACK
}

enum WorkspaceProviderSelection {
  WORKSPACE_DEFAULT
  CLAUDE
  CODEX
}

enum PRState {
  NONE
  DRAFT
  OPEN
  CHANGES_REQUESTED
  APPROVED
  MERGED
  CLOSED
}

enum CIStatus {
  UNKNOWN   // No CI configured or not yet fetched
  PENDING   // CI is running
  SUCCESS   // All checks passed
  FAILURE   // One or more checks failed
}

enum RatchetState {
  IDLE              // No PR or ratchet not active for this workspace
  CI_RUNNING        // CI checks in progress
  CI_FAILED         // CI checks failed
  MERGE_CONFLICT    // PR has merge conflicts with the base branch
  REVIEW_PENDING    // Has unaddressed review comments
  READY             // Ready to merge (CI green, no conflicts, no pending reviews)
  MERGED            // PR has been merged
}

enum RatchetDispatchOutcome {
  RUNNING     // Fixer session dispatched and believed to be working
  COMPLETED   // Fixer ended deliberately (finished its work or was stopped)
  DIED        // Fixer ended unexpectedly (crash / non-zero exit); eligible for bounded retry
}

enum WorkspaceCreationSource {
  MANUAL          // Created manually by user
  RESUME_BRANCH   // Created from existing branch
  GITHUB_ISSUE    // Created from GitHub issue
  LINEAR_ISSUE    // Created from Linear issue
  PERIODIC_TASK   // Created by a periodic task execution
  CHILD_WORKSPACE // Created as a child of another workspace
}

enum IssueProvider {
  GITHUB
  LINEAR
}

enum RunScriptStatus {
  IDLE       // No run script or not started
  STARTING   // Run script is starting
  RUNNING    // Run script is actively running
  STOPPING   // Run script is stopping
  COMPLETED  // Run script completed successfully
  FAILED     // Run script failed
}

enum WorkspaceMode {
  STANDARD
  AUTO_ITERATION
}

enum PeriodicTaskCadence {
  EVERY_MINUTE
  EVERY_FIVE_MINUTES
  DAILY
  WEEKLY
  MONTHLY
}

enum PeriodicTaskExecutionStatus {
  RUNNING       // Workspace created, agent working
  PR_CREATED    // Agent created a PR
  FAILED        // Workspace failed or errored
  SKIPPED       // Skipped (previous run still active)
}

enum AutoIterationStatus {
  IDLE            // Configured but not started
  RUNNING         // Loop is actively iterating
  PAUSED          // User paused the loop
  COMPLETED       // Target reached
  MAX_ITERATIONS  // Hit iteration limit
  STOPPED         // User manually stopped
  FAILED          // Unrecoverable error
}

enum NotificationDirection {
  CHILD_TO_PARENT
  PARENT_TO_CHILD
}


// Models
model Project {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  repoPath          String
  worktreeBasePath  String
  defaultBranch     String      @default("main")
  githubOwner       String?
  githubRepo        String?
  isArchived        Boolean     @default(false)

  // Issue provider configuration
  issueProvider         IssueProvider @default(GITHUB)
  issueTrackerConfig    Json?         // Typed blob — see IssueTrackerConfigSchema

  // Startup script configuration
  startupScriptCommand  String?   // Inline shell command
  startupScriptPath     String?             // Path to script in repo
  startupScriptTimeout  Int       @default(300)  // Timeout in seconds

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  workspaces        Workspace[]
  periodicTasks     PeriodicTask[]

  @@index([slug])
  @@index([isArchived])
  @@index([isArchived, updatedAt])
}

model DecisionLog {
  id                String      @id @default(cuid())
  agentId           String      // Can be sessionId or any identifier
  decision          String
  reasoning         String
  context           String?
  timestamp         DateTime    @default(now())

  @@index([agentId, timestamp])
  @@index([timestamp])
}

model Workspace {
  id                  String            @id @default(cuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id])
  name                String
  description         String?
  status              WorkspaceStatus   @default(NEW)
  worktreePath        String?
  branchName          String?
  isAutoGeneratedBranch Boolean         @default(false)  // True if branch was auto-generated at creation time

  // Workspace creation tracking
  creationSource      WorkspaceCreationSource  @default(MANUAL)  // How this workspace was created
  creationMetadata    Json?                                      // Additional creation context (nullable for flexibility)

  // Initialization tracking (used by NEW, PROVISIONING, FAILED states)
  initErrorMessage    String?
  initOutput          String?           // Accumulated stdout/stderr from startup script
  initStartedAt       DateTime?
  initCompletedAt     DateTime?
  initScriptPid       Int?              // Process ID of running startup/setup script
  initRetryCount      Int                 @default(0)

  // Run script tracking (from factory-factory.json)
  runScriptCommand        String?           // The run script command to execute
  runScriptPostRunCommand String?           // The postRun script command to execute after run is RUNNING
  runScriptCleanupCommand String?           // The cleanup script command to execute on stop
  runScriptPid            Int?              // Process ID of running script
  runScriptPort           Int?              // Allocated port for the running script
  runScriptStartedAt      DateTime?         // When the run script was started
  runScriptStatus         RunScriptStatus   @default(IDLE)  // Run script runtime status

  githubIssueNumber   Int?
  githubIssueUrl      String?
  linearIssueId         String?   // Linear issue UUID
  linearIssueIdentifier String?   // Human-readable e.g. "ENG-123"
  linearIssueUrl        String?   // URL to Linear issue
  defaultSessionProvider WorkspaceProviderSelection @default(WORKSPACE_DEFAULT)
  ratchetSessionProvider WorkspaceProviderSelection @default(WORKSPACE_DEFAULT)
  agentSessions       AgentSession[]
  terminalSessions    TerminalSession[]
  closedSessions      ClosedSession[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // PR tracking (cached from GitHub) — see WorkspacePR
  pr                  WorkspacePR?

  // Ratchet tracking (centralized PR progression) — see WorkspaceRatchet
  ratchet             WorkspaceRatchet?

  // Auto-iteration tracking
  mode                      WorkspaceMode         @default(STANDARD)
  autoIterationStatus       AutoIterationStatus?
  autoIterationConfig       Json?                 // { testCommand, targetDescription, maxIterations, testTimeoutSeconds, sessionRecycleInterval }
  autoIterationProgress     Json?                 // { currentIteration, baselineMetricSummary, currentMetricSummary, counts, timestamps }
  autoIterationSessionId    String?               // Active ACP session for auto-iteration loop

  // Periodic task link
  periodicTaskId        String?
  periodicTask          PeriodicTask?           @relation(fields: [periodicTaskId], references: [id])
  periodicTaskExecution PeriodicTaskExecution?

  // Parent/child workspace hierarchy (max depth 1)
  parentWorkspaceId   String?           @map("parent_workspace_id")
  parentWorkspace     Workspace?        @relation("WorkspaceChildren", fields: [parentWorkspaceId], references: [id])
  childWorkspaces     Workspace[]       @relation("WorkspaceChildren")
  notifications       WorkspaceNotification[]

  // Activity tracking
  hasHadSessions      Boolean           @default(false)

  @@index([projectId])
  @@index([status])
  @@index([parentWorkspaceId])
  // Composite indexes for common query patterns
  @@index([projectId, status])
  @@index([projectId, updatedAt])
  @@index([projectId, createdAt])
  // The three composite indexes that used to lead with `status` and continue
  // into `prUrl` / `prUpdatedAt` / `prDiscoveryNextCheckAt` are gone with those
  // columns. Their queries now filter `status` here and the PR columns on
  // WorkspacePR, which carries the matching indexes.
}

/// What GitHub last told us about the workspace's pull request, plus the
/// bookkeeping for finding that PR and for the notifications we derive from it.
///
/// This is a cache, not a source of truth: every field here is either a copy of
/// GitHub state or a cursor into it, and losing the whole row costs one refresh.
/// It is split out of `Workspace` because that distinction was invisible while
/// the columns sat beside the workspace's own durable identity, and because the
/// compare-and-swap writes that attach and refresh a PR need to guard a row no
/// other concern writes.
///
/// Field names drop the `pr` prefix the columns carried on `Workspace`, where it
/// was doing the work this model's name now does. The flat `pr*` names are still
/// what every caller sees: `workspacePrAccessor` maps between the two, so the
/// split stops at the accessor.
///
/// Exactly one row per workspace, created with the workspace, so the writes that
/// run before a PR exists — discovery claims and their backoff — have a row to
/// guard. Reads substitute defaults if a row is ever missing rather than making
/// every caller handle the null.
model WorkspacePR {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  url         String?                      // The attached PR, or null while none is known
  number      Int?
  state       PRState   @default(NONE)
  reviewState String?                      // Raw GitHub review state
  ciStatus    CIStatus  @default(UNKNOWN)  // CI check status
  // When this cache was last written, not GitHub's PR `updated_at`: every caller
  // passes its own observation time. Callers still say `prUpdatedAt`, which is
  // why the old column read as PR metadata; `syncedAt` is what it always held.
  syncedAt    DateTime?

  // Discovery: locating the PR for the workspace's branch, with backoff.
  discoveryLastCheckedAt DateTime?
  discoveryRetryCount    Int       @default(0)
  discoveryNextCheckAt   DateTime?

  // CI failure notification bookkeeping.
  ciFailedAt       DateTime?               // When CI first failed (cleared on success)
  ciLastNotifiedAt DateTime?               // Last time we notified about CI failure

  // Review comment cursor.
  reviewLastCheckedAt DateTime?            // When PR review comments were last checked
  reviewLastCommentId String?              // ID of the last processed review comment

  // Discovery seeks on `url IS NULL` plus a due time, so it wants both columns in
  // one index; a leftmost-prefix scan also serves plain `url` lookups. Sync
  // filters `url IS NOT NULL` and orders by `syncedAt`, and because that filter
  // is a range on the leading column, a composite there would cost an ordering
  // scan rather than save one -- measured with EXPLAIN QUERY PLAN.
  @@index([url, discoveryNextCheckAt])
  @@index([syncedAt])
}

/// The ratchet's own state for one workspace: whether it is watching the PR,
/// how far the PR progression has got, and the last fixer dispatch.
///
/// Split out of `Workspace` so that the compare-and-swap writes the ratchet
/// relies on guard a row no other concern writes. Every conditional ratchet
/// write tests `enabled` and/or `state` alongside the field it sets, so those
/// two have to live next to the dispatch record for the guards to stay
/// single-statement.
///
/// Exactly one row per workspace, created with the workspace. Reads go through
/// `workspaceRatchetAccessor`, which substitutes these defaults if a row is
/// ever missing (a pre-split backup restored, say) rather than making every
/// caller handle the null.
model WorkspaceRatchet {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled       Boolean      @default(true)   // Workspace-level ratchet toggle
  state         RatchetState @default(IDLE)   // Current state in the ratchet progression
  lastCheckedAt DateTime?                     // When the ratchet last checked this workspace

  // The last fixer dispatch, keyed by the PR state it was dispatched for.
  activeSessionId     String?                 // Active fixer session (if any)
  dispatchSnapshotKey String?                 // PR number + CI signature + review activity + merge conflict. Dedupes fixer dispatches.
  dispatchOutcome     RatchetDispatchOutcome? // Outcome for the key above (null = never dispatched, or reset by a PR change)
  dispatchRetryCount  Int          @default(0) // DIED re-dispatches consumed for the current key

  @@index([enabled, state])
  @@index([lastCheckedAt])
}

model AgentSession {
  id                  String        @id @default(cuid())
  workspaceId         String
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String?
  workflow            String // "explore", "implement", "test"
  model               String        @default("sonnet")
  status              SessionStatus @default(IDLE)
  provider            SessionProvider
  providerSessionId   String?
  providerProjectPath String?
  providerProcessPid  Int?
  providerMetadata    Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([provider])
  @@index([workspaceId, provider])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
}

model TerminalSession {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String?
  status          SessionStatus @default(IDLE)
  pid             Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, updatedAt])
}

model ClosedSession {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sessionId       String          // Original AgentSession ID
  name            String?
  workflow        String          // "ratchet", "ci-fix", etc.
  provider        SessionProvider
  model           String

  transcriptPath  String          // Relative path to transcript JSON file

  startedAt       DateTime
  completedAt     DateTime        @default(now())

  @@index([workspaceId])
  @@index([completedAt])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @default("default") @unique  // Single user for now, expandable later

  // IDE Settings
  preferredIde          String   @default("cursor")  // "cursor" | "vscode" | "custom"
  customIdeCommand      String?  // For custom IDE, supports placeholders like {workspace}

  // Notification Settings
  playSoundOnComplete   Boolean  @default(true)   // Play sound when workspace completes
  notificationSoundPath String?                   // Path to custom notification sound file

  // Sidebar Settings
  workspaceOrder      Json?    // { [projectId]: string[] } - ordered workspace IDs per project

  // Cached slash commands (from Claude CLI initialize response)
  cachedSlashCommands   Json?

  // Ratchet Settings (unified PR progression)
  ratchetEnabled            Boolean  @default(false)  // Default for new GitHub-issue-created workspaces
  ratchetReplyToPrComments  Boolean  @default(true)   // Whether Ratchet should post PR/review comment replies
  ratchetReviewTriggerMode  RatchetReviewTriggerMode @default(CHANGES_REQUESTED)
  defaultSessionProvider    SessionProvider @default(CLAUDE)
  defaultClaudeModel        String @default("sonnet")
  defaultCodexModel         String @default("default")
  defaultClaudeReasoningEffort String?
  defaultCodexReasoningEffort  String?
  defaultWorkspacePermissions SessionPermissionPreset @default(STRICT) // Default execution-mode preset for non-ratchet sessions
  ratchetPermissions        SessionPermissionPreset @default(YOLO) // Default execution-mode preset for ratchet sessions

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model PeriodicTask {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id])

  name          String
  prompt        String
  cadence       PeriodicTaskCadence
  scheduledTime String?
  timezone      String?
  scheduledDayOfMonth Int?

  isEnabled   Boolean              @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  executions  PeriodicTaskExecution[]
  workspaces  Workspace[]

  @@index([projectId])
  @@index([isEnabled, nextRunAt])
}

model PeriodicTaskExecution {
  id              String                       @id @default(cuid())
  periodicTaskId  String
  periodicTask    PeriodicTask                 @relation(fields: [periodicTaskId], references: [id], onDelete: Cascade)

  workspaceId     String?                      @unique
  workspace       Workspace?                   @relation(fields: [workspaceId], references: [id])

  status          PeriodicTaskExecutionStatus
  prUrl           String?
  prNumber        Int?
  errorMessage    String?

  startedAt       DateTime                     @default(now())
  completedAt     DateTime?

  @@index([periodicTaskId])
  @@index([periodicTaskId, status])
  @@index([status])
}

// Queued notifications from child workspaces, delivered when parent's next session starts
model WorkspaceNotification {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceWorkspaceId   String    @map("source_workspace_id")
  sourceWorkspaceName String    @map("source_workspace_name")
  sourceProjectName   String    @map("source_project_name")
  message             String
  direction           NotificationDirection @default(CHILD_TO_PARENT)

  deliveredAt         DateTime? @map("delivered_at") // null = pending delivery

  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("workspace_notifications")
  @@index([workspaceId])
  @@index([workspaceId, deliveredAt])
}
