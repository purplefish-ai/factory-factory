{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "jsPlugins": [
    {
      "name": "factory",
      "specifier": "./lint-rules/factory.mjs"
    }
  ],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["prisma/generated/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "caughtErrors": "all"
      }
    ],
    "no-unused-private-class-members": "error",
    "prefer-const": [
      "error",
      {
        "ignoreReadBeforeAssign": true
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports",
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "curly": ["error", "all"],
    "no-lonely-if": "error",
    "typescript/prefer-enum-initializers": "error",
    "prefer-exponentiation-operator": "error",
    "typescript/prefer-for-of": "error",
    "react/jsx-fragments": ["error", "syntax"],
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/numeric-separators-style": [
      "error",
      {
        "number": {
          "minimumDigits": 5,
          "groupLength": 3,
          "fractionGroupLength": 3
        }
      }
    ],
    "react/self-closing-comp": "error",
    "operator-assignment": ["error", "always"],
    "typescript/prefer-function-type": "error",
    "prefer-template": "error",
    "typescript/no-explicit-any": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-console": "error",
    "no-var": "error",
    "no-empty": "error",
    "no-misleading-character-class": "error",
    "react/no-array-index-key": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/prefer-array-flat-map": "error",
    "react/no-danger": "error",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "factory/no-await-import": "error",
    "factory/no-native-dialogs": "error",
    "factory/icon-button-name": "error",
    "factory/no-next-directives": "error",
    "factory/no-zod-any": "error",
    "factory/no-unsafe-json-parse-cast": "error",
    "factory/no-unsafe-resolver-cast": "error",
    "factory/no-forward-ref": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": [
        "src/backend/services/logger.service.ts",
        "src/lib/debug.ts",
        "src/cli/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "electron/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/client/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/lib/**/*.{ts,tsx}"
      ],
      "rules": {
        "factory/no-raw-palette-classes": "error",
        "factory/use-pending-prop": "error",
        "factory/no-direct-web-storage": "error",
        "factory/no-raw-spinner": "error",
        "factory/no-raw-tab-role": "error",
        "factory/query-owner": [
          "error",
          {
            "groups": [
              {
                "procedures": ["workspace.get", "workspace.listForProject"],
                "use": "src/client/lib/workspace-queries.ts",
                "owners": [
                  "src/client/lib/workspace-queries.ts",
                  "src/client/lib/workspace-cache-reconciler.ts"
                ],
                "helpers": "cache",
                "reason": "plain tRPC reads and writes bypass the snapshot reconciler"
              },
              {
                "procedures": ["userSettings.get", "userSettings.update"],
                "use": "src/client/lib/user-settings-queries.ts",
                "owners": ["src/client/lib/user-settings-queries.ts"],
                "helpers": "all",
                "reason": "its hooks share one optimistic cache strategy and error toast for every settings control"
              },
              {
                "procedures": ["userSettings.getProviderOptions"],
                "use": "src/client/lib/user-settings-queries.ts",
                "owners": ["src/client/lib/user-settings-queries.ts"],
                "helpers": "cache",
                "reason": "live model discovery starts provider processes, so every reader shares one stale time through useProviderOptions"
              }
            ]
          }
        ],
        "factory/named-query-options": "error",
        "factory/query-error-handled": "error",
        "factory/no-arbitrary-font-size": "error",
        "factory/use-status-callout": "error",
        "factory/button-icon-size": "error",
        "factory/button-size-variant": "error",
        "factory/icon-button-tooltip": "error",
        "factory/tooltip-provider-root": "error"
      }
    },
    {
      "files": [
        "src/client/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/hooks/**/*.{ts,tsx}"
      ],
      "rules": {
        "factory/no-render-ref-write": "error",
        "factory/no-state-sync-effect": "error",
        "factory/stable-context-value": "error"
      }
    },
    {
      "files": ["src/components/ui/**/*.{ts,tsx}"],
      "rules": {
        "factory/no-forward-ref": "off"
      }
    },
    {
      "files": ["src/client/**/*.{ts,tsx}"],
      "rules": {
        "factory/focus-ring": "error"
      }
    },
    {
      "files": ["src/client/features/chat/**/*.{ts,tsx}"],
      "rules": {
        "factory/no-tool-input-cast": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "factory/no-raw-palette-classes": "off",
        "factory/query-owner": "off",
        "factory/no-raw-spinner": "off",
        "factory/no-direct-web-storage": "off",
        "factory/named-query-options": "off",
        "factory/no-arbitrary-font-size": "off",
        "factory/use-status-callout": "off",
        "factory/no-render-ref-write": "off",
        "factory/no-state-sync-effect": "off",
        "factory/tooltip-provider-root": "off",
        "factory/no-raw-tab-role": "off",
        "factory/stable-context-value": "off"
      }
    },
    {
      "files": ["**/*.test-harness.tsx"],
      "rules": {
        "factory/tooltip-provider-root": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["**/*.stories.tsx"],
      "rules": {
        "factory/no-state-sync-effect": "off"
      }
    },
    {
      "files": ["src/client/routes/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/client/features/chat",
                "importNames": ["useChatWebSocket"],
                "allowTypeImports": true,
                "message": "Render the chat inside ChatSessionProvider and read it with useChatSessionState, or the layout's summary with useChatSessionSummary. A route that calls useChatWebSocket re-renders on every streamed event."
              },
              {
                "name": "@/client/features/chat/use-chat-websocket",
                "importNames": ["useChatWebSocket"],
                "allowTypeImports": true,
                "message": "Render the chat inside ChatSessionProvider and read it with useChatSessionState, or the layout's summary with useChatSessionSummary. A route that calls useChatWebSocket re-renders on every streamed event."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/client/routes/admin/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/client/features/chat",
                "importNames": ["useChatWebSocket"],
                "allowTypeImports": true,
                "message": "Render the chat inside ChatSessionProvider and read it with useChatSessionState, or the layout's summary with useChatSessionSummary. A route that calls useChatWebSocket re-renders on every streamed event."
              },
              {
                "name": "@/client/features/chat/use-chat-websocket",
                "importNames": ["useChatWebSocket"],
                "allowTypeImports": true,
                "message": "Render the chat inside ChatSessionProvider and read it with useChatSessionState, or the layout's summary with useChatSessionSummary. A route that calls useChatWebSocket re-renders on every streamed event."
              },
              {
                "name": "@/components/ui/card",
                "importNames": ["CardHeader", "CardTitle", "CardDescription", "CardAction"],
                "message": "Use SettingsSection from routes/admin/settings-section.tsx for a settings card's title, icon, description and loading/error states."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/client/routes/admin/settings-section.tsx",
        "src/client/routes/admin/StatCard.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
